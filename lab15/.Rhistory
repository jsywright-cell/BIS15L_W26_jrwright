ui <- dashboardPage(
dashboardHeader(title="Distribution of Gestation Length by Order"),
dashboardSidebar(
selectInput("x",
"Select Order",
choices=sort(unique(gestation$order)),
selected="Afrosoricida"),
selectInput("y",
"Select Interest Variable",
choices = c("bodymass",
"longevity",

)
)
library(tidyverse)
library(shiny)
library(shinydashboard)
library(janitor)
gestation <- read_csv("data/Data_S1.csv") %>%
clean_names() %>%
rename(gestationlength=gestationength)
names(gestation)
wolves <- read_csv("data/wolves_data/wolves_dataset.csv") %>% clean_names()
names(wolves)
wolves %>%
filter(sex!="NA") %>%
ggplot(aes(x=sex, fill=sex))+
geom_bar()+
facet_wrap(~pop)
ui <- dashboardPage(
dashboardHeader(title="Distribution of Gestation Length by Order"),
dashboardSidebar(disable=T),
dashboardBody(
selectInput("x",
"Select Order",
choices=sort(unique(gestation$order)),
selected="Afrosoricida"),
selectInput("y",
"Select Interest Variable",
choices = c("bodymass",
"longevity",
"gestationlength"),
selected = "bodymass"),
plotOutput("plot", width = "600px", height = "500px")
)
)
server <- function(input, output, session) {
output$plot <- renderPlot({
gestation %>%
filter(input$x==.data[["order"]]) %>%
ggplot(aes(.data[[input$y]]))+
geom_density(fill="lightblue2",
color="tomato3",
alpha=0.5)+
theme_linedraw()
})
}
shinyApp(ui, server)
ui <- dashboardPage(

library(shiny)
ui <- dashboardPage(
dashboardHeader(title="Age and Height of Elephants by Sex"),
dashboardSidebar(
selectInput("y",
"Select Elephant Variable",
choices=c("age", "height"),
selected="age")),
dashboardBody(

library(tidyverse)
library(janitor)
library(shiny)
library(shinydashboard)
elephants <- read_csv("data/elephants_data/elephants.csv") %>%
clean_names()
elephants.csv <- read_csv("elephants_app.R")
elephants.csv <- readr::"elephants_app.R"
elephants.csv <- source(elephants_app.R)

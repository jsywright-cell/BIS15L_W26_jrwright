library(tidyverse)
library(janitor)
library(shiny)
library(shinydashboard)
elephants <- read_csv("data/elephants_data/elephants.csv") %>%
clean_names()
names(elephants)
View(elephants)
View(elephants)
library(shiny)
ui <- dashboardPage(
dashboardHeader(title="Age and Height of Elephants by Sex"),
dashboardSidebar(
selectInput("x",
"Select Elephant Sex",
choices=sort(unique(elephants$sex)),
selected="F"),
selectInput("y",
"Select Elephant Variable",
choices=c("age", "height"),
selected="age"))

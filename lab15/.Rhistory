server <- function(input, output, session) {
output$plot <- renderPlot({
elephants %>%
ggplot(aes(x = sex,
y = .data[[input$y]],
fill = sex))+
geom_boxplot(alpha=0.75)+
labs(title="Elephant Variables by Sex",
x="Sex",
fill="Sex")+
theme_linedraw()
})
}
shinyApp(ui, server)

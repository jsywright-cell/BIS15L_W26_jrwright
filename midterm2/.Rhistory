polar_bears %>%
select(lat, long) %>%
summary()
lat <- c(62.46, 72.70)
long <- c(-172.2, -134.8)
bbox <- make_bbox(long, lat, f=0.03)
map1 <- get_stadiamap(bbox, maptype="stamen_terrain", zoom = 7)
ggmap(map1) +
geom_point(data=polar_bears, aes(long, lat), size=1, color=popn, alpha=0.8)+
labs(x="Longitude", y="Latitude", title="Polar Bear Locations")
polar_bears %>%
filter(fasting=="T") %>%
ggplot(aes(x=year, fill=popn))+
geom_bar()+
facet_wrap(~popn)+
coord_flip()+
labs(title="Fasting Bears of Each Population by Year")
polar_bears <- polar_bears %>%
mutate(un_creat_ratio=0.466*urea_nitrogen/creatinine)
polar_bears <- polar_bears %>%
mutate(fasting=case_when(un_creat_ratio<=10 ~ "T",
un_creat_ratio>10 ~ "F"))
polar_bears %>%
filter(fasting=="T") %>%
ggplot(aes(x=year, fill=popn))+
geom_bar()+
facet_wrap(~popn)+
coord_flip()+
labs(title="Fasting Bears of Each Population by Year")
ggmap(map1) +
geom_point(data=polar_bears, aes(long, lat), size=1, color=popn, alpha=0.8)+
labs(x="Longitude", y="Latitude", title="Polar Bear Locations")
ggmap(map1) +
geom_point(data=polar_bears, aes(long, lat), size=1, color="popn", alpha=0.8)+
labs(x="Longitude", y="Latitude", title="Polar Bear Locations")
runApp('~/Desktop/BIS15L_W2026_Group-8-main/rbird/shiny_app/rbird.R')

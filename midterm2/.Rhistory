library(shiny)
ui <- fluidPage(
selectizeInput("x",
"Select X Variable",
choices=c("sex",
"mating",
"age_class",
"denning",
"fasting"),
selected="sex"),
plotOutput("plot",
width="500px",
height="400px")
)
server <- function(input, output, session) {
output$plot <- renderPlot({
polar_bears %>%
ggplot(aes(x=popn, y=un_creat_ratio, fill=.data[[input$x]]))+
geom_boxplot()+
labs(title = "Urea Nitrogen to Creatinine Ratio by Population",
x="Population",
y="Urea Nitrogen to Creatinine Ratio",
fill=input$x)
}
shinyApp(ui, server)

library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
register_stadiamaps("fe8a9330-64f5-48b0-a3f6-3a339791bdaf", write = FALSE)
polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class==c("A", "S")) %>%
mutate(sex=toupper(sex),
age_class=toupper(age_class))
polar_bears <- polar_bears %>%
replace_with_na(replace = list(mating = "unknown",
denning = "unknown",
sex = "unknown"))
miss_var_summary(polar_bears)
polar_bears %>%
count(popn, sex)
polar_bears %>%
count(popn, sex) %>%
ggplot(aes(x=popn, y=n, fill=sex))+
geom_col(position="dodge")+
labs(title="Sex Sampling by Population",
x="Population",
y="Count"")
polar_bears %>%
count(popn, sex) %>%
ggplot(aes(x=popn, y=n, fill=sex))+
geom_col(position="dodge")+
labs(title="Sex Sampling by Population",
x="Population",
y="Count")
polar_bears %>%
filter(popn=="SB") %>%
group_by(year) %>%
summarize(total_SB=count()) %>%
ggplot(aes(x=year, y=total_SB))+
geom_line(color="tomato3")+
geom_point(shape=3)+
labs(title = "SB Sample Population by Year",
x="Year",
y="Count")

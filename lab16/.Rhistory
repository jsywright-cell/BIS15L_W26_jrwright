library(tidyverse)
library(janitor)
library(naniar)
library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
polar_bears_feedback <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class %in% c("A", "S")) %>%
mutate(
sex = toupper(sex),
age_class = toupper(age_class)
) %>%
replace_with_na(replace = list(
mating = "unknown",
denning = "unknown"
)) %>%
mutate(
capture_date = ymd(capture_date),
year = year(capture_date),
un_creat_ratio = (0.466 * urea_nitrogen) / creatinine,
fasting = case_when(
un_creat_ratio <= 10 ~ "fasting",
un_creat_ratio > 10 ~ "not fasting"
)
)
glimpse(polar_bears_feedback)
polar_bears_feedback %>%
miss_var_summary()
polar_bears_feedback %>%
gg_miss_var()
polar_bears_feedback %>%
count(popn, sex)
polar_bears_feedback %>%
count(popn, sex) %>%
ggplot(aes(x = popn, y = n, fill = sex)) +
geom_col(position = "dodge") +
labs(
title = "Bears Sampled by Population and Sex",
x = "Population",
y = "Count"
)
polar_bears %>%
ggplot(aes(x=sex, fill=sex))+
geom_bar()+
facet_wrap(~popn)+
labs(title="Sex Sampling by Population")
library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
register_stadiamaps("fe8a9330-64f5-48b0-a3f6-3a339791bdaf", write = FALSE)
polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class==c("A", "S")) %>%
mutate(sex=toupper(sex),
age_class=toupper(age_class))
polar_bears %>%
ggplot(aes(x=sex, fill=sex))+
geom_bar()+
facet_wrap(~popn)+
labs(title="Sex Sampling by Population")

library(tidyverse)
library(palmerpenguins)
names(penguins)
glimpse(penguins)
ggplot(data=penguins, #this specifies the data
mapping=aes(x=species, y=body_mass_g)) #map the aesthetics
ggplot(data=penguins, #this specifies the data
mapping=aes(x=species, y=body_mass_g))+ #map the aesthetics
geom_boxplot()
ggplot(data=penguins,
mapping=aes(x=species, y=flipper_length_mm))+
geom_boxplot()
names(penguins)
ggplot(data=penguins,
mapping=aes(x=body_mass_g, y=flipper_length_mm))+
geom_point()
ggplot(data=penguins,
mapping=aes(x=body_mass_g, y=flipper_length_mm))+
geom_point(na.rm=T)+
geom_smooth(method=lm, se=T)
ggplot(data=penguins,
mapping=aes(x=body_mass_g, y=flipper_length_mm, color=species))+
geom_point(na.rm=T)+
geom_smooth(method=lm, se=T)
ggplot(data=penguins,
mapping=aes(x=body_mass_g, y=flipper_length_mm))+
geom_point(mapping=aes(color=species))+
geom_smooth(method=lm, se=T)
ggplot(data=penguins,
mapping=aes(x=body_mass_g, y=flipper_length_mm))+
geom_point(mapping=aes(color=bill_depth_mm, shape=island))+
geom_smooth(method=lm, se=T)
ggplot(data=penguins,
mapping=aes(x=body_mass_g, y=flipper_length_mm))+
geom_point(mapping=aes(color=bill_depth_mm, shape=island))+
geom_smooth(method=lm, se=T)+
labs(title="Body Mass(g) vs. Flipper Length(mm)", x="Body Mass (g)", y="Flipper Length (mm)")
ggplot(data=penguins,
mapping=aes(x=bill_length_mm, y=bill_depth_mm))+
geom_point(mapping=aes(color=species, shape=sex))+
geom_smooth(method=lm, se=F)+
labs(title="Bill Length (mm) vs. Bill Depth (mm)")
names(penguins)
names(penguins)
ggplot(data=penguins,
mapping=aes(x=species))+
geom_bar(mapping=aes(color=species))
ggplot(data=penguins,
mapping=aes(x=species))+
geom_bar(mapping=aes(fill=species))
ggplot(data=penguins,
mapping=aes(x=island))+
geom_bar(mapping=aes(fill=species), position="dodge")+
labs(title="#Penguins for each species by island")
ggplot(data=penguins,
mapping=aes(x=island))+
geom_bar()

anolis %>%
filter(habitat=="Grass-bush") %>%
summarise(grass_lamellae_avg=mean(toepad_lamellae_count))
anolis %>%
filter(habitat=="Trunk-crown") %>%
summarise(grass_lamellae_avg=mean(toepad_lamellae_count))
anolis %>%
filter(habitat=="Trunk-crown") %>%
summarise(crown_lamellae_avg=mean(toepad_lamellae_count))
anolis %>%
filter(habitat=="Trunk-ground") %>%
summarise(ground_lamellae_avg=mean(toepad_lamellae_count))
anolis %>%
filter(habitat=="Twig") %>%
summarise(twig_lamellae_avg=mean(toepad_lamellae_count))
anolis %>%
select(toepad_lamellae_count, habitat, island) %>%
filter(habitat=="Trunk-crown") %>%
ggplot(mapping=aes(x=island, y=toepad_lamellae_count))+
geom_boxplot(mapping=aes(fill=island))+
labs(title="toepad lamellae vs. island for trunk-crown species")

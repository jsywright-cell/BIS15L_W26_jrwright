library(tidyverse)
library(janitor)
sydneybeaches <- read_csv("data/sydneybeaches.csv")
glimpse(sydneybeaches)
sydneybeaches_long <- sydneybeaches %>%
select(Site, Date, `Enterococci (cfu/100ml)`)
sydneybeaches_wide <- sydneybeaches %>%
pivot_wider(names_from = "Date",
values_from = "Enterococci (cfu/100ml)")
sydneybeaches_wide %>%
pivot_longer(-c(BeachId, Region, Council, Site, Longitude, Latitude),
names_to = "Date",
values_to = "Enterococci (cfu/100ml)")
sydneybeaches_long <- sydneybeaches_long %>%
separate(Date, into = c("day", "month", "year"), sep = "/")
sydneybeaches_long
sydneybeaches_long %>%
group_by(year, Site) %>%
summarize(mean_enterococci_cfu_100ml=mean(`Enterococci (cfu/100ml)`))
enterococci_cfu_100ml_by_year <- sydneybeaches_long %>%
group_by(year, Site) %>%
summarize(mean_enterococci_cfu_100ml=mean(`Enterococci (cfu/100ml)`))
enterococci_cfu_100ml_by_year
enterococci_cfu_100ml_by_year %>%
pivot_wider(names_from = year,
values_from = mean_enterococci_cfu_100ml)
enterococci_cfu_100ml_by_year <- sydneybeaches_long %>%
group_by(year, Site) %>%
summarize(mean_enterococci_cfu_100ml=mean(`Enterococci (cfu/100ml), na.rm=T`))
enterococci_cfu_100ml_by_year <- sydneybeaches_long %>%
group_by(year, Site) %>%
summarize(mean_enterococci_cfu_100ml=mean(`Enterococci (cfu/100ml)`, na.rm=T))
enterococci_cfu_100ml_by_year
enterococci_cfu_100ml_by_year %>%
pivot_wider(names_from = year,
values_from = mean_enterococci_cfu_100ml)
enterococci_cfu_100ml_by_year_long <- sydneybeaches_long %>%
group_by(year, Site) %>%
summarize(mean_enterococci_cfu_100ml=mean(`Enterococci (cfu/100ml)`, na.rm=T))
enterococci_cfu_100ml_by_year_long
enterococci_cfu_100ml_by_year_long %>%
pivot_wider(names_from = year,
values_from = mean_enterococci_cfu_100ml)
enterococci_cfu_100ml_by_year_wide %>% enterococci_cfu_100ml_by_year_long %>%
pivot_wider(names_from = year,
values_from = mean_enterococci_cfu_100ml)
enterococci_cfu_100ml_by_year_wide <- enterococci_cfu_100ml_by_year_long %>%
pivot_wider(names_from = year,
values_from = mean_enterococci_cfu_100ml)
enterococci_cfu_100ml_by_year_wide <- enterococci_cfu_100ml_by_year_long %>%
pivot_wider(names_from = year,
values_from = mean_enterococci_cfu_100ml)
enterococci_cfu_100ml_by_year_wide
enterococci_cfu_100ml_by_year_wide %>%
filter(year=="2013") %>%
max()
enterococci_cfu_100ml_by_year_wide %>%
filter(year="2013") %>%
max()
enterococci_cfu_100ml_by_year_wide %>%
filter(year=="2013") %>%
max()
enterococci_cfu_100ml_by_year_wide %>%
filter(year=="2013")
enterococci_cfu_100ml_by_year_wide %>%
select("2013") %>%
max()
enterococci_cfu_100ml_by_year_wide %>%
select("2013") %>%
group_by(Site)
enterococci_cfu_100ml_by_year_wide %>%
group_by(Site) %>%
select("2013") %>%
enterococci_cfu_100ml_by_year_wide %>%
select("2013") %>%
group_by(Site)
enterococci_cfu_100ml_by_year_wide %>%
select("2013") %>%
group_by(Site)
enterococci_cfu_100ml_by_year_wide %>%
group_by(Site) %>%
select("2013")
enterococci_cfu_100ml_by_year_wide %>%

knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(janitor)
sydneybeaches <- read_csv("data/sydneybeaches.csv")
glimpse(sydneybeaches)
sydneybeaches_long <- sydneybeaches %>%
select(Site, Date, `Enterococci (cfu/100ml)`)
sydneybeaches_wide <- sydneybeaches %>%
pivot_wider(names_from = "Date",
values_from = "Enterococci (cfu/100ml)")
sydneybeaches_wide %>%
pivot_longer(-c(BeachId, Region, Council, Site, Longitude, Latitude),
names_to = "Date",
values_to = "Enterococci (cfu/100ml)")
sydneybeaches_long <- sydneybeaches_long %>%
separate(Date, into = c("day", "month", "year"), sep = "/")
sydneybeaches_long
enterococci_cfu_100ml_by_year_long <- sydneybeaches_long %>%
group_by(year, Site) %>%
summarize(mean_enterococci_cfu_100ml=mean(`Enterococci (cfu/100ml)`, na.rm=T))
enterococci_cfu_100ml_by_year_long
enterococci_cfu_100ml_by_year_wide <- enterococci_cfu_100ml_by_year_long %>%
pivot_wider(names_from = year,
values_from = mean_enterococci_cfu_100ml)
enterococci_cfu_100ml_by_year_wide
enterococci_cfu_100ml_by_year_long_2013 <- enterococci_cfu_100ml_by_year_long %>%
filter(year=="2013") %>%
group_by(mean_enterococci_cfu_100ml, Site) %>%
arrange(desc(mean_enterococci_cfu_100ml))
enterococci_cfu_100ml_by_year_long_2013 %>%
slice_tail(n=5)
enterococci_cfu_100ml_by_year_long %>%
filter(year=="2013") %>%
group_by(mean_enterococci_cfu_100ml, Site) %>%
arrange(desc(mean_enterococci_cfu_100ml))
View(sydneybeaches)
sydneybeaches_long %>%
group_by(year, `Enterococci (cfu/100ml)`) %>%
summarise(overall_yearly_avg=mean(`Enterococci (cfu/100ml)`))
sydneybeaches_long %>%
group_by(year, `Enterococci (cfu/100ml)`) %>%
summarise(overall_yearly_avg=mean(`Enterococci (cfu/100ml)`, na.rm=T))
sydneybeaches_long %>%
group_by(Site, `Enterococci (cfu/100ml)`) %>%
summarise(overall_yearly_avg=mean(`Enterococci (cfu/100ml)`, na.rm=T))
sydneybeaches_long %>%
group_by(Site) %>%
summarise(overall_yearly_avg=mean(`Enterococci (cfu/100ml)`, na.rm=T))
sydneybeaches_long %>%
group_by(Site, year) %>%
summarise(overall_yearly_avg=mean(`Enterococci (cfu/100ml)`, na.rm=T))
sydneybeaches_long %>%
group_by(year) %>%
summarise(overall_yearly_avg=mean(`Enterococci (cfu/100ml)`, na.rm=T))
sydneybeaches_long %>%
group_by(year) %>%
summarise(overall_yearly_avg=mean(`Enterococci (cfu/100ml)`, na.rm=T)) %>%
slice_head(n=6)
sydneybeaches_long %>%
group_by(year) %>%
summarise(overall_yearly_avg=mean(`Enterococci (cfu/100ml)`, na.rm=T)) %>%
arrange(desc(overall_yearly_avg)) %>%
slice_head(n=6)

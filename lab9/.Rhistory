knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(janitor)
sydneybeaches <- read_csv("data/sydneybeaches.csv")
glimpse(sydneybeaches)
sydneybeaches_long <- sydneybeaches
View(sydneybeaches)
sydneybeaches_long <- sydneybeaches %>%
select(Site, Date, `Enterococci (cfu/100ml)`)
sydneybeaches_long
sydneybeaches_wide <- sydneybeaches %>%
pivot_wider(names_from = "Dates",
values_from = "Site")
sydneybeaches_wide <- sydneybeaches %>%
pivot_wider(names_from = "Date",
values_from = "Site")
sydneybeaches_wide <- sydneybeaches %>%
pivot_wider(names_from = "Date",
values_from = "Site")
sydneybeaches_wide
View(sydneybeaches_long)
View(sydneybeaches_wide)
sydneybeaches_wide %>%
pivot_longer(-c(BeachId, Region, Council, Longitude, Latitude, `Enterococci (cfu/100ml)`),
names_to = "Date",
values_to = "Site")
sydneybeaches_wide %>%
pivot_longer(-c(BeachId, Region, Council, Longitude, Latitude, `Enterococci (cfu/100ml)`),
names_to = "Site",
values_to = "Date")
sydneybeaches_wide %>%
pivot_longer(-c(BeachId, Region, Council, Longitude, Latitude, `Enterococci (cfu/100ml)`),
names_to = "Date",
values_to = "Site")
sydneybeaches_wide <- sydneybeaches %>%
pivot_wider(names_from = "Site",
values_from = "Date")
sydneybeaches_wide
View(sydneybeaches_wide)
sydneybeaches_wide %>%
pivot_longer(-c(BeachId, Region, Council, Longitude, Latitude, `Enterococci (cfu/100ml)`),
names_to = "Date",
values_to = "Site")
sydneybeaches_wide %>%
pivot_longer(-c(BeachId, Region, Council, Longitude, Latitude, `Enterococci (cfu/100ml)`),
names_to = "Site",
values_to = "Date")

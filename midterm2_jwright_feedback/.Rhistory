library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class == c("A", "S")) %>%
mutate(
sex = toupper(sex),
age_class = toupper(age_class)
)
names(polar_bears)
glimpse(polar_bears)
polar_bears <- polar_bears %>%
replace_with_na(replace = list(
mating = "unknown",
denning = "unknown"
))
polar_bears %>% miss_var_summary()
polar_bears %>% gg_miss_var()
polar_bears %>%
count(sex, popn)
polar_bears %>%
ggplot(aes(x = popn, fill = sex)) +
geom_bar(position = "dodge", color = "black", alpha = 0.8) +
labs(
title = "Sampling of Bears by Sex and Population",
x = "Population",
y = "Number of Bears",
fill = "Sex"
) +
theme_minimal()
polar_bears <- polar_bears %>%
mutate(
capture_date = ymd(capture_date),
year = year(capture_date)
)
polar_bears %>%
count(year, popn) %>%
ggplot(aes(x = year, y = n, color = popn)) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
labs(
title = "Bears Sampled per Year by Population",
x = "Year",
y = "Number of Bears",
color = "Population"
) +
theme_minimal()
polar_bears %>%
summarise(
min_urea = min(urea_nitrogen, na.rm = TRUE),
median_urea = median(urea_nitrogen, na.rm = TRUE),
mean_urea = mean(urea_nitrogen, na.rm = TRUE),
max_urea = max(urea_nitrogen, na.rm = TRUE),
min_creatinine = min(creatinine, na.rm = TRUE),
median_creatinine = median(creatinine, na.rm = TRUE),
mean_creatinine = mean(creatinine, na.rm = TRUE),
max_creatinine = max(creatinine, na.rm = TRUE)
)
polar_bears <- polar_bears %>%
mutate(un_creat_ratio = (urea_nitrogen * 0.466) / creatinine)
polar_bears <- polar_bears %>%
mutate(
fasting = case_when(
un_creat_ratio <= 10 ~ "yes",
un_creat_ratio > 10 ~ "no"
)
)
polar_bears %>%
filter(fasting == "yes") %>%
count(year, popn) %>%
ggplot(aes(x = year, y = n, color = popn)) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
labs(
title = "Fasting Bears by Year and Population",
x = "Year",
y = "Number of Fasting Bears",
color = "Population"
) +
theme_minimal()
ui <- fluidPage(
selectInput(
"fill_var",
"Select Fill Variable",
choices = c("sex", "mating", "age_class", "denning", "fasting"),
selected = "sex"
),
plotOutput("plot", width = "600px", height = "500px")
)
server <- function(input, output, session) {
output$plot <- renderPlot({
polar_bears %>%
ggplot(aes(x = popn, y = un_creat_ratio, fill = .data[[input$fill_var]])) +
geom_boxplot(alpha = 0.8) +
labs(
title = "Range of Urea Nitrogen to Creatinine Ratio",
x = "Population",
y = "UN:Creatinine Ratio",
fill = "Selected Variable"
) +
theme_minimal()
})
}
shinyApp(ui, server)
library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
polar_bears_feedback <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class %in% c("A", "S")) %>%
mutate(
sex = toupper(sex),
age_class = toupper(age_class)
) %>%
replace_with_na(replace = list(
mating = "unknown",
denning = "unknown"
)) %>%
mutate(
capture_date = ymd(capture_date),
year = year(capture_date),
un_creat_ratio = (0.466 * urea_nitrogen) / creatinine,
fasting = case_when(
un_creat_ratio <= 10 ~ "fasting",
un_creat_ratio > 10 ~ "not fasting"
)
)
polar_bears_feedback %>%
count(popn, sex)
polar_bears_feedback %>%
count(popn, sex) %>%
ggplot(aes(x = popn, y = n, fill = sex)) +
geom_col(position = "dodge") +
labs(
title = "Bears Sampled by Population and Sex",
x = "Population",
y = "Count"
)
polar_bears_feedback %>%
count(popn, sex)
polar_bears_feedback %>%
count(popn, sex) %>%
ggplot(aes(x = popn, y = n, fill = sex)) +
geom_col(position = "dodge") +
labs(
title = "Bears Sampled by Population and Sex",
x = "Population",
y = "Count"
)
polar_bears_feedback %>%
summarise(
min_urea = min(urea_nitrogen, na.rm = TRUE),
median_urea = median(urea_nitrogen, na.rm = TRUE),
mean_urea = mean(urea_nitrogen, na.rm = TRUE),
max_urea = max(urea_nitrogen, na.rm = TRUE),
min_creatinine = min(creatinine, na.rm = TRUE),
median_creatinine = median(creatinine, na.rm = TRUE),
mean_creatinine = mean(creatinine, na.rm = TRUE),
max_creatinine = max(creatinine, na.rm = TRUE)
)
polar_bears <- polar_bears %>%
mutate(un_creat_ratio=0.466*urea_nitrogen/creatinine)
library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
register_stadiamaps("fe8a9330-64f5-48b0-a3f6-3a339791bdaf", write = FALSE)
polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class==c("A", "S")) %>%
mutate(sex=toupper(sex),
age_class=toupper(age_class))
names(polar_bears)
summary(polar_bears)
#polar_bears %>%
#  summarise(across(everything(), ~sum("unknown")))
polar_bears <- polar_bears %>%
replace_with_na(replace = list(mating = "unknown",
denning = "unknown",
sex = "unknown"))
miss_var_summary(polar_bears)
polar_bears %>%
gg_miss_var()
polar_bears %>%
ggplot(aes(x=sex, fill=sex))+
geom_bar()+
facet_wrap(~popn)+
labs(title="Sex Sampling by Population")
polar_bears <- polar_bears %>%
separate(capture_date, into = c("year", "month", "day"), sep="-")
#polar_bears %>%
#  filter(popn=="SB") %>%
#  mutate(total_SB=count(popn)) %>%
#  ggplot(aes(x=year, y=total_SB))+
#  geom_line(color="tomato3")+
#  geom_point(shape=3)+
#  labs(title = "SB Sample Population by Year",
#       x="Year",
#      y="Count")
#polar_bears %>%
#  filter(popn=="CS") %>%
#  ggplot(aes(x=year, y=count(popn)))+
# geom_line(color="tomato3")+
#  geom_point(shape=3)+
#  labs(title = "CS Sample Population by Year",
#       x="Year",
#      y="Count")
polar_bears %>%
summarize(min_urea=min(urea_nitrogen),
max_urea=max(urea_nitrogen),
mean_urea=mean(urea_nitrogen),
median_urea=median(urea_nitrogen))
polar_bears %>%
summarise(min_creatinine=min(creatinine),
max_creatinine=max(creatinine),
mean_creatinine=mean(creatinine),
median_creatinine=median(creatinine))
polar_bears <- polar_bears %>%
mutate(un_creat_ratio=0.466*urea_nitrogen/creatinine)
polar_bears <- polar_bears %>%
mutate(fasting=case_when(un_creat_ratio<=10 ~ "T",
un_creat_ratio>10 ~ "F"))
polar_bears %>%
filter(fasting=="T") %>%
ggplot(aes(x=year, fill=popn))+
geom_bar()+
facet_wrap(~popn)+
coord_flip()+
labs(title="Fasting Bears of Each Population by Year")
polar_bears %>%
select(lat, long) %>%
summary()
lat <- c(62.46, 72.70)
long <- c(-172.2, -134.8)
bbox <- make_bbox(long, lat, f=0.03)
map1 <- get_stadiamap(bbox, maptype="stamen_terrain", zoom = 7)
ggmap(map1) +
geom_point(data=polar_bears, aes(long, lat), size=1, color="tomato3", alpha=0.8)+
labs(x="Longitude", y="Latitude", title="Polar Bear Locations")
polar_bears <- polar_bears %>%
mutate(un_creat_ratio=0.466*urea_nitrogen/creatinine)
polar_bears <- polar_bears %>%
mutate(fasting=case_when(un_creat_ratio<=10 ~ "T",
un_creat_ratio>10 ~ "F"))
polar_bears_feedback %>%
select(urea_nitrogen, creatinine, un_creat_ratio) %>%
slice_head(n = 5)
polar_bears_feedback %>%
count(fasting)
lat <- c(62.46, 72.70)
long <- c(-173.1, -134.8)
bbox <- make_bbox(long, lat, f = 0.10)
map1 <- get_stadiamap(bbox, maptype = "stamen_terrain", zoom = 6)
ggmap(map1) +
geom_point(
data = polar_bears_feedback,
aes(x = long, y = lat, color = popn),
size = 1.5,
alpha = 0.8
) +
labs(
title = "Polar Bear Distribution by Population",
x = "Longitude",
y = "Latitude",
color = "Population"
)
glimpse(polar_bears_feedback)

filter(bodywt > 150) %>%
distinct(genus)
msleep %>%
filter(bodywt > 150) %>%
summarize(n_genera=n_distinct(genus))
msleep %>%
filter(bodywt > 150)
msleep %>%
filter(bodywt > 150) %>%
summarize(total=n())
msleep %>%
filter(bodywt > 150) %>%
distinct(genus) %>%

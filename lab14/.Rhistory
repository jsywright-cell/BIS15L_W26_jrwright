server <- function(input, output, session) {
output$plot <- renderPlot({
# Check if homerange dataset exists
if (!exists("homerange")) {
plot.new()
text(0.5, 0.5, "homerange dataset not found\nPlease load the dataset first",
cex = 1.5)
return()
}
ggplot(data = homerange,
aes(x = locomotion, fill = .data[[input$x]])) +
geom_bar(position = "dodge", alpha = 0.8, color = "black") +
labs(x = "Locomotion",
y = "Count",
fill = "Fill Variable") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
})
}
shinyApp(ui, server)
library(tidyverse)
library(janitor)
register_stadiamaps("fe8a9330-64f5-48b0-a3f6-3a339791bdaf", write = FALSE)
install.packages("ggmap")
library(ggmap)
install.packages("leaflet")
library(leaflet)
register_stadiamaps("fe8a9330-64f5-48b0-a3f6-3a339791bdaf", write = FALSE)
spiders <- read_csv("data/spiders_with_locs.csv")%>%
clean_names() %>%
filter(latitude<=42)
View(spiders)
names(spiders)
spiders %>%
select(latitude, longitude) %>%
summary()
lat <- c(34.67, 41.80)
long <- c(-124.1, -115.5)
bbox <- make_bbox(long, lat, f=0.03)
map1 <- get_stadiamap(bbox, maptype="stamen_terrain", zoom = 7)
ggmap(map1)
ggmap(map1) +
geom_point(data=spiders, aes(longitude, latitude), size=1, color="red", alpha=0.8)+
labs(x="Longitude", y="Latitude", title="CA Usofila Records")
spiders %>%
summarize(
lon_min=min(longitude, na.rm=T),
lon_max=max(longitude, na.rm=T),
lat_min=min(latitude, na.rm=T),
lat_max=max(latitude, na.rm=T))
lon_min <- -124.13
lon_max <- -115.49
lat_min <- 34.67
lat_max <- 41.8
lon_min <- -124.13
lon_max <- -115.49
lat_min <- 34.67
lat_max <- 41.8
leaflet(spiders) %>%
addProviderTiles(providers$Stadia.StamenTerrain) %>%
addCircleMarkers(
lng = ~longitude,
lat = ~latitude,
radius=2,
stroke = FALSE,
fillOpacity=0.7
) %>%
addScaleBar(position="bottomleft") %>%
fitBounds(lng1=lon_min, lat1=lat_min,
lng2=lon_max, lat2=lat_max)
leaflet(spiders) %>%
addTiles() %>%
addCircleMarkers(
lng = ~longitude,
lat = ~latitude,
radius=2,
stroke = FALSE,
fillOpacity=0.7
) %>%
addScaleBar(position="bottomleft") %>%
fitBounds(lng1=lon_min, lat1=lat_min,
lng2=lon_max, lat2=lat_max)

library("tidyverse")
library("janitor")
elephants <- read_csv("data/elephants.csv") %>%
clean_names() %>%
mutate(across(where(is.character), as.factor))
View(elephants)
elephants %>%
summarize(across(avg_age==mean(estimated_age_years),
avg_shoulder_height==mean(shoulder_height_in_cm),
avg_tusk_length==mean(tusk_length_in_cm),
avh_tusk_circumference==mean(tusk_circumference_in_cm)))

library("tidyverse")
options(scipen=999) #turn off scientific notation
homerange <- read_csv("data/Tamburelloetal_HomeRangeDatabase")
homerange <- read_csv("data/Tamburelloetal_HomeRangeDatabase.csv")
glimpse(homerange)
summary(homerange)
glimpse(homerange)
names(homerange)
ggplot(data=homerange,
mapping=aes(x=class))+
geom_bar(mapping=aes(color=fill))
ggplot(data=homerange,
mapping=aes(x=class))+
geom_bar(mapping=aes(fill=color))
ggplot(data=homerange,
mapping=aes(x=class))+
geom_bar(mapping=aes(fill=colour))
ggplot(data=homerange,
mapping=aes(x=class))+
geom_bar(mapping=aes(fill=class))
?homerange
ggplot(data=homerange,
mapping=aes(x=class))+
geom_bar(mapping=aes(fill=class))+
labs(title="Number of each class")
ggplot(data=homerange,
mapping=aes(x=trophic.guild))+
geom_boxplot(color=trophic.guild)+
labs(title="# of animals in each trophic guild")
ggplot(data=homerange,
mapping=aes(x="trophic.guild"))+
geom_boxplot(color="trophic.guild")+
labs(title="# of animals in each trophic guild")
ggplot(data=homerange,
mapping=aes(x="trophic.guild"))+
geom_boxplot()+
labs(title="# of animals in each trophic guild")
